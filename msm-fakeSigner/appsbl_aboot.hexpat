#include <std/mem.pat>

// Qualcomm Appsbl MBN Header (Non-Unified, 40 bytes)
// Generated by mkheader, layout derived from non_unified_boot_magic[10]
struct QcomAppsblHeader {
    u32 image_id;              // 0x00: appsbl (expected 0x00000005)
    u32 flash_partition_ver;   // 0x04: Flash partition version (nand = 3)
    u32 image_source_ptr;      // 0x08: Image source pointer
    u32 image_dest_ptr;        // 0x0C: Image destination (load) address
    u32 total_image_size;      // 0x10: size + cert_chain_size + signature_size
    u32 code_size;             // 0x14: Raw executable code size
    u32 code_end_addr;         // 0x18: base + code_size
    u32 signature_size;        // 0x1C: Signature length (256 = 0x100 for SHA-256)
    u32 cert_chain_start_addr; // 0x20: base + code_size + signature_size
    u32 cert_chain_size;       // 0x24: Certificate chain length (padded)
    u8  payload[];             // Payload follows immediately (Code + Sig + Certs)
};

// Anchor the pattern to offset 0x00 of the opened file
QcomAppsblHeader header @ 0x00;
